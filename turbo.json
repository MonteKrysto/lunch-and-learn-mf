{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {},
    "preview": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "build"
      ]
    }
  }
}
